{
  "$schema": "node_modules/wrangler/config-schema.json",
  "compatibility_date": "2026-08-04",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "jornapharmacy-db-local",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations",
      "migrations_table": "d1_migrations",
      "remote": false,
    },
  ],
  "env": {
    "staging": {
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "jornapharmacy-db-stage",
          "database_id": "a8a2253f-2483-4af5-af1d-9e62ef13bf34",
          "migrations_dir": "migrations",
          "migrations_table": "d1_migrations",
          "remote": true,
        },
      ],
    },
    "production": {
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "jornapharmacy-db",
          "database_id": "a81bfd70-80e0-436a-ad06-61fb39cf2517",
          "migrations_dir": "migrations",
          "migrations_table": "d1_migrations",
          "remote": true,
        },
      ],
    },
  },
}
