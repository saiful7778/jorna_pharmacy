table accounts {
  id text [pk, not null]
  account_id text [not null]
  provider_id text [not null]
  access_token text
  refresh_token text
  id_token text
  access_token_expires_at integer
  refresh_token_expires_at integer
  scope text
  password text
  user_id text [not null]
  created_at integer [not null, default: `(unixepoch() * 1000)`]
  updated_at integer [not null, default: `(unixepoch() * 1000)`]

  indexes {
    
    (provider_id, account_id) [name: 'account_accountProvider_accountId_idx', unique]
    user_id [name: 'account_userId_idx']
  }
}

table company_payments {
  id text [pk, not null]
  company_id text [not null]
  purchase_id text
  amount real [not null]
  note text
  created_by text
  created_at integer [not null, default: `(unixepoch() * 1000)`]
  updated_at integer [not null, default: `(unixepoch() * 1000)`]

  indexes {
    
    
    
    
    company_id [name: 'companyPayment_companyId_idx']
    created_at [name: 'companyPayment_createdAt_idx']
    created_by [name: 'companyPayment_createdBy_idx']
  }
}

table companies {
  id text [pk, not null]
  name text [not null]
  phone text
  address text
  note text
  is_active integer [not null, default: 1]
  created_at integer [not null, default: `(unixepoch() * 1000)`]
  updated_at integer [not null, default: `(unixepoch() * 1000)`]

  indexes {
    name [name: 'company_name_idx']
  }
}

table customer_payments {
  id text [pk, not null]
  customer_id text [not null]
  sale_id text
  amount real [not null]
  note text
  created_by text
  created_at integer [not null, default: `(unixepoch() * 1000)`]
  updated_at integer [not null, default: `(unixepoch() * 1000)`]

  indexes {
    
    
    
    
    customer_id [name: 'customerPayment_customerId_idx']
    sale_id [name: 'customerPayment_saleId_idx']
    created_at [name: 'customerPayment_createdAt_idx']
  }
}

table customers {
  id text [pk, not null]
  name text [not null]
  phone text
  address text
  note text
  is_active integer [not null, default: 1]
  created_at integer [not null, default: `(unixepoch() * 1000)`]
  updated_at integer [not null, default: `(unixepoch() * 1000)`]

  indexes {
    phone [name: 'customer_phone_idx']
    name [name: 'customer_name_idx']
  }
}

table medicines {
  id text [pk, not null]
  name text [not null]
  generic_name text
  strength text
  company_id text
  type text [not null]
  base_unit text [not null]
  rack_location text
  minimum_stock integer [not null, default: 0]
  is_active integer [not null, default: 1]
  created_at integer [not null, default: `(unixepoch() * 1000)`]
  updated_at integer [not null, default: `(unixepoch() * 1000)`]

  indexes {
    
    name [name: 'medicine_name_idx']
    company_id [name: 'medicine_companyId_idx']
  }
}

table permissions {
  id text [pk, not null]
  level text [not null]
  resource text [not null]
  action text [not null]
  description text
  created_at integer [not null, default: `(unixepoch() * 1000)`]
  updated_at integer [not null, default: `(unixepoch() * 1000)`]

  indexes {
    (level, resource, action) [name: 'permission_level_resource_action_key', unique]
    level [name: 'permission_level_idx']
    resource [name: 'permission_resource_idx']
    action [name: 'permission_action_idx']
  }
}

table purchase_items {
  id text [pk, not null]
  purchase_id text [not null]
  medicine_id text [not null]
  batch_no text
  qty_purchased integer [not null]
  qty_remaining integer [not null]
  cost_per_unit real [not null]
  sell_per_unit real [not null]
  expiry_date integer
  created_at integer [not null, default: `(unixepoch() * 1000)`]
  updated_at integer [not null, default: `(unixepoch() * 1000)`]

  indexes {
    
    
    
    purchase_id [name: 'purchaseItem_purchaseId_idx']
    (medicine_id, expiry_date) [name: 'purchaseItem_medicineExpiry_idx']
  }
}

table purchase_return_items {
  id text [pk, not null]
  purchase_return_id text [not null]
  purchase_item_id text [not null]
  qty integer [not null]
  unit_cost real [not null]
  created_at integer [not null, default: `(unixepoch() * 1000)`]

  indexes {
    
    
    
    purchase_return_id [name: 'purchaseReturnItem_returnId_idx']
  }
}

table purchase_returns {
  id text [pk, not null]
  compnay_id text [not null]
  purchase_id text [not null]
  total_amount real [not null]
  reason text
  created_by text
  created_at integer [not null, default: `(unixepoch() * 1000)`]
  updated_at integer [not null, default: `(unixepoch() * 1000)`]

  indexes {
    
    
    
    compnay_id [name: 'companyId_idx']
    created_by [name: 'purchaseReturn_createdBy_idx']
  }
}

table purchases {
  id text [pk, not null]
  company_id text [not null]
  company_invoice_no text
  subtotal real [not null]
  discount real [not null, default: 1]
  total_amount real [not null]
  paid_amount real [not null, default: 0]
  note text
  created_by text
  created_at integer [not null, default: `(unixepoch() * 1000)`]
  updated_at integer [not null, default: `(unixepoch() * 1000)`]

  indexes {
    
    
    (company_id, company_invoice_no) [name: 'purchase_companyInvoice_idx', unique]
    company_id [name: 'purchase_companyId_idx']
    created_at [name: 'purchase_createdAt_idx']
  }
}

table role_permissions {
  id text [pk, not null]
  role_id text [not null]
  permission_id text [not null]
  created_at integer [not null, default: `(unixepoch() * 1000)`]

  indexes {
    
    
    (role_id, permission_id) [name: 'role_permission_unique', unique]
    role_id [name: 'role_permission_role_idx']
    permission_id [name: 'role_permission_permission_idx']
  }
}

table roles {
  id text [pk, not null]
  role_name text [not null, default: 'USER']
  description text

  indexes {
    role_name [name: 'role_name_unique', unique]
  }
}

table sale_invoices {
  id text [pk, not null]
  number text [not null]
  is_linked integer [not null, default: 0]
  reserved_by text
  reserved_until integer
  created_at integer [not null, default: `(unixepoch() * 1000)`]
  updated_at integer [not null, default: `(unixepoch() * 1000)`]

  indexes {
    
    number [name: 'sale_invoice_number_idx', unique]
    (is_linked, reserved_until) [name: 'sale_invoice_reservation_idx']
  }
}

table sale_items {
  id text [pk, not null]
  sale_id text [not null]
  medicine_id text [not null]
  purchase_item_id text [not null]
  qty integer [not null]
  unit_price real [not null]
  unit_cost real [not null]
  line_total real [not null]
  created_at integer [not null, default: `(unixepoch() * 1000)`]

  indexes {
    
    
    
    
    sale_id [name: 'saleItem_saleId_idx']
    medicine_id [name: 'saleItem_medicineId_idx']
    purchase_item_id [name: 'saleItem_purchaseItemId_idx']
  }
}

table sales {
  id text [pk, not null]
  invoice_id text [not null]
  customer_id text
  subtotal real [not null]
  discount real [not null, default: 0]
  total_amount real [not null]
  paid_amount real [not null, default: 0]
  created_by text
  created_at integer [not null, default: `(unixepoch() * 1000)`]
  updated_at integer [not null, default: `(unixepoch() * 1000)`]

  indexes {
    
    
    
    invoice_id [name: 'sale_invoiceId_idx', unique]
    customer_id [name: 'sale_customerId_idx']
    created_at [name: 'sale_createdAt_idx']
    created_by [name: 'sale_createdBy_idx']
  }
}

table sessions {
  id text [pk, not null]
  token text [not null]
  ip_address text
  user_agent text
  impersonated_by text
  user_id text [not null]
  expires_at integer [not null]
  created_at integer [not null, default: `(unixepoch() * 1000)`]
  updated_at integer [not null, default: `(unixepoch() * 1000)`]

  indexes {
    
    token [name: 'session_token_idx', unique]
    user_id [name: 'session_userId_idx']
    expires_at [name: 'session_expiresAt_idx']
  }
}

table user_devices {
  id text [pk, not null]
  user_id text [not null]
  fingerprint text [not null]
  browser text
  os text
  device_type text
  first_seen_at integer [not null, default: `(unixepoch() * 1000)`]
  last_seen_at integer [not null, default: `(unixepoch() * 1000)`]
  created_at integer [not null, default: `(unixepoch() * 1000)`]
  updated_at integer [not null, default: `(unixepoch() * 1000)`]

  indexes {
    
    (user_id, fingerprint) [name: 'user_device_user_fingerprint_idx', unique]
    user_id [name: 'user_device_user_id_idx']
  }
}

table user_events {
  id text [pk, not null]
  user_id text
  email text
  event text [not null]
  session_id text
  device_id text
  ip_address text
  user_agent text
  created_at integer [not null, default: `(unixepoch() * 1000)`]

  indexes {
    
    
    user_id [name: 'user_event_user_id_idx']
    event [name: 'user_event_event_idx']
    created_at [name: 'user_event_created_at_idx']
    session_id [name: 'user_event_session_id_idx']
  }
}

table user_roles {
  id text [pk, not null]
  role_id text [not null]
  user_id text [not null]
  assigned_at integer [not null, default: `(unixepoch() * 1000)`]

  indexes {
    
    
    (user_id, role_id) [name: 'user_role_unique', unique]
    role_id [name: 'user_role_role_id_idx']
    user_id [name: 'user_role_user_id_idx']
  }
}

table user_sessions {
  id text [pk, not null]
  user_id text [not null]
  device_id text
  session_id text [not null]
  login_at integer [not null, default: `(unixepoch() * 1000)`]
  last_seen_at integer [not null, default: `(unixepoch() * 1000)`]
  logout_at integer
  expires_at integer
  created_at integer [not null, default: `(unixepoch() * 1000)`]
  updated_at integer [not null, default: `(unixepoch() * 1000)`]

  indexes {
    
    
    
    user_id [name: 'user_session_user_id_idx']
    session_id [name: 'user_session_session_id_idx', unique]
    login_at [name: 'user_session_login_at_idx']
    last_seen_at [name: 'user_session_last_seen_at_idx']
  }
}

table users {
  id text [pk, not null]
  name text [not null]
  email text [not null]
  email_verified integer [not null, default: 0]
  image text
  role text [not null]
  banned integer [default: 0]
  ban_reason text
  ban_expires integer
  timezone text [not null, default: 'UTC']
  locale text [not null, default: 'en-US']
  currency text [not null, default: 'USD']
  created_at integer [not null, default: `(unixepoch() * 1000)`]
  updated_at integer [not null, default: `(unixepoch() * 1000)`]

  indexes {
    email [name: 'user_email_key', unique]
  }
}

table verifications {
  id text [pk, not null]
  identifier text [not null]
  value text [not null]
  expires_at integer [not null]
  created_at integer [not null, default: `(unixepoch() * 1000)`]
  updated_at integer [not null, default: `(unixepoch() * 1000)`]
}

